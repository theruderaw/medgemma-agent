MODEL_NAME=qwen3:4b
SPECIALIST_MODEL_NAME=medgemma1.5:4b
TRIAGE_MODEL_NAME=qwen3:0.6b
TRIAGE_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=120

SESSION_STORE=memory
# SessionStore options: memory | redis | postgres
# SESSION_STORE=postgres
# AUDIT_ENABLED=true          # defaults to true when SESSION_STORE=postgres
# DATABASE_URL=postgresql:///medgemma-agent   # schema managed via alembic upgrade head
REDIS_URL=redis://localhost:6379/0
SESSION_TIMEOUT_SECONDS=1800
MAX_HISTORY_MESSAGES=40
MAX_CONTEXT_MESSAGES=20
MAX_CONTEXT_CHARS=16000

# Audit trail: every transaction is always appended to AUDIT_FILE as one JSON
# object per line (append-only, independent of AUDIT_ENABLED). When
# AUDIT_ENABLED is on, events are also mirrored to the Postgres audit_events
# table. AUDIT_LLM_CAP_CHARS trims long LLM-generated content in audit records.
# AUDIT_FILE=app/logs/audit.jsonl
# AUDIT_LLM_CAP_CHARS=1000

# Processing mode: sync (inline) | queued (Celery worker). Queued requires
# SESSION_STORE=redis.
PROCESSING_MODE=sync
JOB_RESULT_EXPIRE_SECONDS=3600   # TTL for Celery job results in Redis
JOB_MAX_RETRIES=3                # retries for transient model-server failures
JOB_CONCURRENCY=1                # worker concurrency (raise for multi-user; Ollama/VRAM is the real gate)