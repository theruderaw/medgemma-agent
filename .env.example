MODEL_NAME=qwen3:4b
SPECIALIST_MODEL_NAME=medgemma1.5:4b
TRIAGE_MODEL_NAME=qwen3:0.6b
TRIAGE_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=120

SESSION_STORE=memory
# SessionStore options: memory | redis | postgres
# SESSION_STORE=postgres
# AUDIT_ENABLED=true          # defaults to true when SESSION_STORE=postgres
# DATABASE_URL=postgresql:///medgemma-agent   # schema managed via alembic upgrade head
REDIS_URL=redis://localhost:6379/0
SESSION_TIMEOUT_SECONDS=1800
MAX_HISTORY_MESSAGES=40
MAX_CONTEXT_MESSAGES=20
MAX_CONTEXT_CHARS=16000