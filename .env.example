MODEL_NAME=qwen3:4b
SPECIALIST_MODEL_NAME=medgemma1.5:4b
TRIAGE_MODEL_NAME=medgemma1.5:4b   # text-only triage; images are held back and sent during analysis

# Output guardrails (spec 8.1): every outgoing reply is judged by the small
# guard model against five violation categories; verdicts map to fixed safety
# notes or the emergency directive. Always on.
GUARD_MODEL_NAME=qwen3:0.6b
GUARD_MIN_CHARS=200                              # skip the guard LLM call for shorter replies

# Image input (Milestone 7): uploads are validated with Pillow, EXIF-stripped,
# re-encoded to JPEG, and downscaled before reaching any model. PDFs
# (application/pdf) have their first page rendered via pypdfium2 and then go
# through the identical sanitize path; multi-page PDFs disclose the truncation.
IMAGE_MAX_BYTES=5242880                         # max decoded upload size (5 MB)
IMAGE_ALLOWED_MIME=image/jpeg,image/png,image/webp,application/pdf
IMAGE_MAX_DIMENSION_PX=1024                     # longest edge after downscale / PDF render target
# IMAGE_UPLOAD_DIR=app/data/uploads             # sanitized images persist here

OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=120
TEMPERATURE=0.5                                # sampling temp for router + specialist (triage stays 0)

# DATABASE_URL=postgresql:///medgemma-agent   # schema managed via alembic upgrade head
REDIS_URL=redis://localhost:6379/0
MAX_HISTORY_MESSAGES=40
MAX_CONTEXT_MESSAGES=20
MAX_CONTEXT_CHARS=16000

# Audit trail: every transaction is always appended to AUDIT_FILE as one JSON
# object per line (append-only) and mirrored to the Postgres audit_events
# table. AUDIT_LLM_CAP_CHARS trims long LLM-generated content in audit records.
# AUDIT_FILE=app/logs/audit.jsonl
# AUDIT_LLM_CAP_CHARS=1000

# Chat turns always run through the Celery worker (Redis broker).
JOB_RESULT_EXPIRE_SECONDS=3600   # TTL for Celery job results in Redis
JOB_MAX_RETRIES=3                # retries for transient model-server failures
JOB_CONCURRENCY=1                # worker concurrency (raise for multi-user; Ollama/VRAM is the real gate)